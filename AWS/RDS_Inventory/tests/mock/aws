#!/usr/bin/env python3
"""Stub `aws` for testing rds_inventory_report.sh. It never talks to AWS (no network code at all) and refuses
any non describe-/list- operation (exit 99). Output shapes follow `aws rds <op> --generate-cli-skeleton output`
(validate_cli.sh checks that). Times are relative to now (or MOCK_NOW epoch). Env:
  MOCK_SCENARIO = fleet (default) | empty | paramdenied | globalfail | nolc | badcreds | large
  MOCK_LARGE_N = instances for 'large' (default 1500) ; MOCK_LOG = JSONL of argv ; MOCK_DEFAULT_REGION
Profiles: prod -> 111111111111 (us-east-1 + ap-south-1), nonprod -> 222222222222 (ap-south-1), broken -> bad creds.
"""
import json, os, sys
from datetime import datetime, timedelta, timezone

NOW = datetime.fromtimestamp(int(os.environ["MOCK_NOW"]), timezone.utc) if os.environ.get("MOCK_NOW") else datetime.now(timezone.utc)
SCEN = os.environ.get("MOCK_SCENARIO", "fleet")


def fail(code, op, msg, rc=254):
    sys.stderr.write("\naws: [ERROR]: An error occurred (%s) when calling the %s operation: %s\n\n" % (code, op, msg)); sys.exit(rc)


argv = sys.argv[1:]
if os.environ.get("MOCK_LOG"):
    with open(os.environ["MOCK_LOG"], "a") as fh:
        fh.write(json.dumps(argv) + "\n")
if argv[:1] == ["--version"]:
    print("aws-cli/2.38.2 Python/3.14.6 Linux/6.12 exe/x86_64.mock"); sys.exit(0)
if argv[:3] == ["configure", "get", "region"]:
    r = os.environ.get("MOCK_DEFAULT_REGION", "")
    if r:
        print(r); sys.exit(0)
    sys.exit(1)

GLOBAL_VAL = {"--output", "--profile", "--region", "--cli-connect-timeout", "--cli-read-timeout"}
ALLOWED = {("sts", "get-caller-identity"): set(), ("ec2", "describe-regions"): set(),
           ("rds", "describe-db-clusters"): set(), ("rds", "describe-db-instances"): set(), ("rds", "describe-global-clusters"): set(),
           ("rds", "describe-db-cluster-endpoints"): set(), ("rds", "describe-pending-maintenance-actions"): set(),
           ("rds", "describe-certificates"): set(), ("rds", "describe-db-major-engine-versions"): {"--engine"},
           ("rds", "describe-db-parameters"): {"--db-parameter-group-name"}, ("rds", "describe-db-cluster-parameters"): {"--db-cluster-parameter-group-name"}}
g, o, pos, i = {}, {}, [], 0
while i < len(argv):
    a = argv[i]
    if a == "--no-cli-pager":
        g[a] = True
    elif a in GLOBAL_VAL:
        g[a] = argv[i + 1]; i += 1
    elif a.startswith("--"):
        o[a] = argv[i + 1] if i + 1 < len(argv) else ""; i += 1
    else:
        pos.append(a)
    i += 1
if len(pos) == 2 and not pos[1].startswith(("describe-", "list-", "get-")) and pos[0] != "configure":
    sys.stderr.write("mock: NON-READ OPERATION ATTEMPTED: %s\n" % " ".join(pos)); sys.exit(99)
if pos and pos[0] == "cloudwatch":
    sys.stderr.write("mock: CLOUDWATCH CALL ATTEMPTED\n"); sys.exit(99)
if SCEN == "nolc" and tuple(pos) == ("rds", "describe-db-major-engine-versions"):
    sys.stderr.write("\naws: error: argument operation: Invalid choice, valid choices are:\n"); sys.exit(252)
if len(pos) != 2 or tuple(pos) not in ALLOWED:
    sys.stderr.write("\naws: [ERROR]: mock does not implement: %s\n" % " ".join(pos)); sys.exit(252)
bad = set(o) - ALLOWED[tuple(pos)]
if bad:
    sys.stderr.write("\naws: [ERROR]: Unknown options: %s\n" % ", ".join(sorted(bad))); sys.exit(252)
if g.get("--output") != "json" or "--no-cli-pager" not in g:
    sys.stderr.write("mock: script must pass --output json --no-cli-pager\n"); sys.exit(252)
REGION = g.get("--region") or os.environ.get("AWS_REGION", "")
if not REGION:
    sys.stderr.write("\naws: [ERROR]: An error occurred (NoRegion): You must specify a region.\n"); sys.exit(253)
PROFILE = g.get("--profile", "")
SVC, OP = pos
if PROFILE == "broken" or SCEN == "badcreds":
    fail("InvalidClientTokenId", "GetCallerIdentity", "The security token included in the request is invalid.")
ACCT = {"": "111111111111", "prod": "111111111111", "nonprod": "222222222222"}.get(PROFILE)
if ACCT is None:
    sys.stderr.write("\nThe config profile (%s) could not be found\n" % PROFILE); sys.exit(255)


def out(d):
    print(json.dumps(d, indent=2)); sys.exit(0)


def t(days):
    return (NOW + timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S.000000+00:00")


if (SVC, OP) == ("sts", "get-caller-identity"):
    out({"UserId": "AIDAMOCKUSER", "Account": ACCT, "Arn": "arn:aws:iam::%s:user/dba" % ACCT})
if (SVC, OP) == ("ec2", "describe-regions"):
    out({"Regions": [{"Endpoint": "ec2.%s.amazonaws.com" % r, "RegionName": r, "OptInStatus": "opt-in-not-required"} for r in ("us-east-1", "ap-south-1", "eu-west-1")]})
if SCEN == "paramdenied" and OP in ("describe-db-parameters", "describe-db-cluster-parameters"):
    fail("AccessDenied", "DescribeDBParameters", "User is not authorized to perform: rds:DescribeDBParameters")
if SCEN == "globalfail" and OP == "describe-global-clusters":
    fail("Throttling", "DescribeGlobalClusters", "Rate exceeded")


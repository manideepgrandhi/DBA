            "SubnetGroupStatus": "Complete", "Subnets": [{"SubnetIdentifier": "subnet-0aaa%04d" % k, "SubnetAvailabilityZone": {"Name": REGION + z}, "SubnetStatus": "Active"}
                                                         for k, z in enumerate("abc")]}


def inst(ident, engine, ver, cls="db.r6g.large", cluster=None, az="a", tg=None, **kw):

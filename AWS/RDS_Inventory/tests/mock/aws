         "Port": kw.get("port", 5432), "AvailabilityZones": [REGION + z for z in "abc"], "BackupRetentionPeriod": kw.get("ret", 7),
         "DBClusterParameterGroup": kw.get("cpg", "default.%s" % engine), "DBSubnetGroup": "db-private", "PreferredBackupWindow": "19:00-19:30",
         "PreferredMaintenanceWindow": "sat:21:00-sat:21:30", "MultiAZ": len(members) > 1, "StorageEncrypted": kw.get("enc", True),
         "KmsKeyId": "arn:aws:kms:%s:%s:key/00000000-1111-2222-3333-444444444444" % (REGION, ACCT), "DbClusterResourceId": "cluster-ABC%s" % ident,
         "DBClusterArn": arn("cluster", ident), "IAMDatabaseAuthenticationEnabled": kw.get("iam", True), "ClusterCreateTime": t(-kw.get("age", 800)),
         "DeletionProtection": kw.get("dp", True), "EnabledCloudwatchLogsExports": kw.get("logs", []), "TagList": tg or [], "AllocatedStorage": kw.get("gb", 1),
         "VpcSecurityGroups": [{"VpcSecurityGroupId": "sg-0db%013d" % 2, "Status": "active"}], "StorageType": kw.get("st", "aurora"),
         "EngineLifecycleSupport": "open-source-rds-extended-support", "DatabaseInsightsMode": kw.get("dbi", "standard"),
         "PerformanceInsightsEnabled": kw.get("pi", False), "MonitoringInterval": 0, "AutoMinorVersionUpgrade": True,
         "DBClusterMembers": [{"DBInstanceIdentifier": m, "IsClusterWriter": k == 0, "DBClusterParameterGroupStatus": kw.get("cpgs", "in-sync"), "PromotionTier": k + 1}
                              for k, m in enumerate(members)]}
    if kw.get("sv2"):
        d["ServerlessV2ScalingConfiguration"] = {"MinCapacity": kw["sv2"][0], "MaxCapacity": kw["sv2"][1]}
    if kw.get("glob"):
        d["GlobalClusterIdentifier"] = kw["glob"]
    if kw.get("cls"):
        d["DBClusterInstanceClass"] = kw["cls"]
    if kw.get("iops"):
        d["Iops"] = kw["iops"]
    if "postgres" in engine and not engine.startswith("aurora"):
        d["CertificateDetails"] = cert()
    CL.append(d)
    azs = kw.get("azs", "abc")
    for k, m in enumerate(members):
        inst(m, engine, ver, cls=kw.get("mcls", kw.get("cls", "db.r6g.large")), cluster=ident, az=azs[k % len(azs)], tg=tg, tier=k + 1,
             pi=kw.get("mpi", True), port=kw.get("port", 5432), pg=kw.get("mpg", "default.%s" % engine), logs=[])
    return d


def endpoint(cl, ident, ctype, static, excluded=()):
    EP.append({"DBClusterEndpointIdentifier": ident, "DBClusterIdentifier": cl, "DBClusterEndpointResourceIdentifier": "cluster-endpoint-" + ident,
               "Endpoint": "%s.cluster-custom-cxyzabc123.%s.rds.amazonaws.com" % (ident, REGION), "Status": "available", "EndpointType": "CUSTOM",
               "CustomEndpointType": ctype, "StaticMembers": list(static), "ExcludedMembers": list(excluded), "DBClusterEndpointArn": arn("cluster-endpoint", ident)})
    EP.append({"DBClusterEndpointIdentifier": cl, "DBClusterIdentifier": cl, "Endpoint": "%s.cluster-cxyzabc123.%s.rds.amazonaws.com" % (cl, REGION),
               "Status": "available", "EndpointType": "WRITER"})



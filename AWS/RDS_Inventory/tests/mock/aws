         "Endpoint": {"Address": "%s.cxyzabc123.%s.rds.amazonaws.com" % (ident, REGION), "Port": kw.get("port", 5432), "HostedZoneId": "Z2R2ITUGPM61AM"},
         "InstanceCreateTime": t(-kw.get("age", 400)), "PreferredBackupWindow": "20:30-21:00", "BackupRetentionPeriod": kw.get("ret", 7),
         "VpcSecurityGroups": [{"VpcSecurityGroupId": "sg-0db%013d" % 1, "Status": "active"}],
         "DBParameterGroups": [{"DBParameterGroupName": kw.get("pg", "default.%s" % engine), "ParameterApplyStatus": kw.get("pgs", "in-sync")}],
         "AvailabilityZone": REGION + az, "DBSubnetGroup": subnet(), "PreferredMaintenanceWindow": "sun:22:00-sun:22:30",
         "MultiAZ": kw.get("maz", False), "AutoMinorVersionUpgrade": kw.get("auto", True), "PubliclyAccessible": kw.get("public", False),
         "StorageType": kw.get("st", "aurora" if cluster else "gp3"), "StorageEncrypted": kw.get("enc", True),
         "KmsKeyId": "arn:aws:kms:%s:%s:key/00000000-1111-2222-3333-444444444444" % (REGION, ACCT) if kw.get("enc", True) else None,
         "DbiResourceId": "db-" + ident.upper().replace("-", "")[:20], "CACertificateIdentifier": kw.get("ca", "rds-ca-rsa2048-g1"),
         "CopyTagsToSnapshot": True, "MonitoringInterval": kw.get("mon", 60), "DBInstanceArn": arn("db", ident),
         "IAMDatabaseAuthenticationEnabled": kw.get("iam", False), "PerformanceInsightsEnabled": kw.get("pi", True), "DeletionProtection": kw.get("dp", True),
         "EnabledCloudwatchLogsExports": kw.get("logs", ["postgresql"] if "postgres" in engine else []),
         "TagList": tg or [], "DatabaseInsightsMode": kw.get("dbi", "standard"), "EngineLifecycleSupport": kw.get("els", "open-source-rds-extended-support"),
         "OptionGroupMemberships": [{"OptionGroupName": kw.get("og", "default:%s" % engine), "Status": "in-sync"}],
         "DbInstancePort": 0}
    if kw.get("pi", True):
        d["PerformanceInsightsRetentionPeriod"] = kw.get("pir", 7)
    if not d["KmsKeyId"]:
        del d["KmsKeyId"]
    if kw.get("cert", True):
        d["CertificateDetails"] = cert(d["CACertificateIdentifier"], kw.get("cadays", 3000))
    if cluster:
        d["DBClusterIdentifier"] = cluster
        d["PromotionTier"] = kw.get("tier", 1)
        d.pop("AllocatedStorage", None)
        d["AllocatedStorage"] = 1
    else:
        d["AllocatedStorage"] = kw.get("gb", 100)
        if kw.get("iops"):
            d["Iops"] = kw["iops"]
        if kw.get("tp"):
            d["StorageThroughput"] = kw["tp"]
        if kw.get("maxgb"):
            d["MaxAllocatedStorage"] = kw["maxgb"]
    if kw.get("maz"):
        d["SecondaryAvailabilityZone"] = REGION + "b"
    if kw.get("src"):
        d["ReadReplicaSourceDBInstanceIdentifier"] = kw["src"]
    d["ReadReplicaDBInstanceIdentifiers"] = kw.get("replicas", [])
    if d["DBInstanceStatus"] == "stopped":
        d["AutomaticRestartTime"] = t(5)
    INS.append(d); return d


def cluster(ident, engine, ver, members, tg=None, **kw):
    d = {"DBClusterIdentifier": ident, "Engine": engine, "EngineVersion": ver, "EngineMode": "provisioned", "Status": kw.get("status", "available"),

A = "arn:aws:rds:%s:%s:%s:%s"


def arn(kind, ident, region=None):
    return A % (region or REGION, ACCT, kind, ident)


def tags(env, owner, app):
    return [{"Key": "Environment", "Value": env}, {"Key": "Owner", "Value": owner}, {"Key": "Application", "Value": app}]


def cert(ca="rds-ca-rsa2048-g1", days=3000):
    return {"CAIdentifier": ca, "ValidTill": t(days)}


def subnet():

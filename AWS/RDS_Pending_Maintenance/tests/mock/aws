def arn(kind, ident):
    return "arn:aws:rds:%s:%s:%s:%s" % (REGION, ACCT, kind, ident)


def tags(env=None, owner=None, app=None, **extra):
    t = [{"Key": k, "Value": v} for k, v in (("Environment", env), ("Owner", owner), ("Application", app)) if v]
    return t + [{"Key": k, "Value": v} for k, v in extra.items()]


def inst(iid, engine, ver, cls, win, tg, cluster=None, **kw):
    d = {"DBInstanceIdentifier": iid, "DBInstanceClass": cls, "Engine": engine, "DBInstanceStatus": "available",
         "Endpoint": {"Address": "%s.cxyz.%s.rds.amazonaws.com" % (iid, REGION), "Port": 5432, "HostedZoneId": "Z2R2ITUGPM61AM"},
         "AvailabilityZone": REGION + "a", "PreferredMaintenanceWindow": win, "PreferredBackupWindow": "18:00-18:30",
         "EngineVersion": ver, "AutoMinorVersionUpgrade": True, "PubliclyAccessible": False, "MultiAZ": False,
         "StorageType": "gp3", "DBInstanceArn": arn("db", iid), "TagList": tg, "CACertificateIdentifier": "rds-ca-rsa2048-g1",
         "DbiResourceId": "db-" + iid.upper().replace("-", "")[:20]}
    if cluster:
        d["DBClusterIdentifier"] = cluster
    d.update(kw)
    return d


def clus(cid, engine, ver, win, tg, members, **kw):
    d = {"DBClusterIdentifier": cid, "DBClusterArn": arn("cluster", cid), "Engine": engine, "EngineVersion": ver,
         "Status": "available", "PreferredMaintenanceWindow": win, "PreferredBackupWindow": "18:00-18:30",
         "MultiAZ": len(members) > 1, "EngineMode": "provisioned", "AutoMinorVersionUpgrade": True, "TagList": tg, "StorageEncrypted": True,
         "DBClusterMembers": [{"DBInstanceIdentifier": m, "IsClusterWriter": k == 0, "DBClusterParameterGroupStatus": "in-sync",
                               "PromotionTier": 1} for k, m in enumerate(members)]}
    d.update(kw)
    return d


def act(action, desc, auto=None, forced=None, cur=None, opt=None):
    d = {"Action": action, "Description": desc}
    if auto is not None: d["AutoAppliedAfterDate"] = days(auto)
    if forced is not None: d["ForcedApplyDate"] = days(forced)
    if cur is not None: d["CurrentApplyDate"] = days(cur)
    if opt: d["OptInStatus"] = opt
    return d



    cluster("graph-neptune", "neptune", "1.3.2.1", ["graph-neptune-1"], tags("prod", "graph", "recs"))
    inst("unrelated-redis-like", "custom-sqlserver-ee", "15.00.4073.23.cev1", tg=[])  # out of scope engine: ignored
elif SCEN != "empty" and REGION == "ap-south-1" and PROFILE == "nonprod":
    cluster("dev-aurora-pg15", "aurora-postgresql", "15.4", ["dev-pg15-1"], tags("dev", "platform", "dev"))
    inst("qa-pg", "postgres", "17.4", tg=tags("qa", "platform", "qa"))

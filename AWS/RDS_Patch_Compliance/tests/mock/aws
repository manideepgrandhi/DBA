CAT = {
    "aurora-postgresql": fam("16", ["16.1", "16.2", "16.3", "16.4", "16.6", "16.8", "16.9"]) + fam("15", ["15.4", "15.5", "15.6", "15.7", "15.8", "15.10", "15.12", "15.13"])
        + fam("14", ["14.9", "14.10", "14.11", "14.12", "14.13", "14.15", "14.17", "14.18"]) + fam("12", ["12.15", "12.16", "12.17", "12.18", "12.19", "12.20", "12.22"])
        + fam("11", ["11.21"]),
    "aurora-mysql": fam("8.0", ["3.04.0", "3.04.1", "3.04.2", "3.04.3", "3.05.2", "3.06.0", "3.06.1", "3.07.1", "3.08.0", "3.08.1", "3.08.2", "3.09.0", "3.10.0"], AMY)
        + fam("5.7", ["2.11.6", "2.12.1", "2.12.4"], "5.7.mysql_aurora.%s"),

#!/usr/bin/env python3
"""Stub `aws` for testing rds_patch_compliance_report.sh. It never talks to AWS (no network code at all).

Output shapes follow `aws <svc> <op> --generate-cli-skeleton output` (AWS CLI v2.37); validate_cli.sh checks that.
Lifecycle dates are relative to now. Env:
  MOCK_SCENARIO = fleet (default) | empty | lookupfail | nolc | lcfail | accessdenied | badcreds | large
  MOCK_LARGE_N  = instances for 'large' (default 3000) ; MOCK_LOG = JSONL of argv
  MOCK_DEFAULT_REGION = answer for `aws configure get region`
Profiles: prod -> 111111111111 (us-east-1 fleet), nonprod -> 222222222222 (ap-south-1 fleet), (none) -> prod,
          broken -> invalid credentials. Other regions are empty.
"""
import json, os, sys
from datetime import datetime, timedelta, timezone

NOW = datetime.now(timezone.utc)
SCEN = os.environ.get("MOCK_SCENARIO", "fleet")


def day(n):
    return (NOW + timedelta(days=n)).strftime("%Y-%m-%dT00:00:00+00:00")


def fail(code, op, msg, rc=254):
    sys.stderr.write("\naws: [ERROR]: An error occurred (%s) when calling the %s operation: %s\n\n" % (code, op, msg))
    sys.exit(rc)


argv = sys.argv[1:]
if os.environ.get("MOCK_LOG"):
    with open(os.environ["MOCK_LOG"], "a") as fh:
        fh.write(json.dumps(argv) + "\n")
if argv[:1] == ["--version"]:
    print("aws-cli/2.37.12 Python/3.14.6 Linux/6.12 exe/x86_64.mock"); sys.exit(0)
if argv[:3] == ["configure", "get", "region"]:
    r = os.environ.get("MOCK_DEFAULT_REGION", "")
    if r:
        print(r); sys.exit(0)
    sys.exit(1)

GLOBAL_VAL = {"--output", "--profile", "--region", "--cli-connect-timeout", "--cli-read-timeout"}
ALLOWED = {("sts", "get-caller-identity"): set(), ("ec2", "describe-regions"): set(),
           ("rds", "describe-db-clusters"): set(), ("rds", "describe-db-instances"): set(),
           ("rds", "describe-pending-maintenance-actions"): set(),
           ("rds", "describe-db-engine-versions"): {"--engine", "--engine-version"}, ("docdb", "describe-db-engine-versions"): {"--engine", "--engine-version"},
           ("neptune", "describe-db-engine-versions"): {"--engine", "--engine-version"},
           ("rds", "describe-db-major-engine-versions"): {"--engine"}}
g, o, pos, i = {}, {}, [], 0
while i < len(argv):
    a = argv[i]
    if a == "--no-cli-pager":
        g[a] = True
    elif a in GLOBAL_VAL:
        g[a] = argv[i + 1]; i += 1
    elif a.startswith("--"):
        o[a] = argv[i + 1] if i + 1 < len(argv) else ""; i += 1
    else:
        pos.append(a)
    i += 1
if SCEN == "nolc" and tuple(pos) == ("rds", "describe-db-major-engine-versions"):
    sys.stderr.write("\nusage: aws [options] <command> <subcommand> [<subcommand> ...] [parameters]\naws: error: argument operation: Invalid choice, valid choices are:\n"); sys.exit(252)
if len(pos) != 2 or tuple(pos) not in ALLOWED:
    sys.stderr.write("\naws: [ERROR]: mock does not implement: %s\n" % " ".join(pos)); sys.exit(252)
bad = set(o) - ALLOWED[tuple(pos)]
if bad:
    sys.stderr.write("\naws: [ERROR]: Unknown options: %s\n" % ", ".join(sorted(bad))); sys.exit(252)
if g.get("--output") != "json" or "--no-cli-pager" not in g:
    sys.stderr.write("mock: script must pass --output json --no-cli-pager\n"); sys.exit(252)
REGION = g.get("--region") or os.environ.get("AWS_REGION", "")
if not REGION:
    sys.stderr.write("\naws: [ERROR]: An error occurred (NoRegion): You must specify a region.\n"); sys.exit(253)
PROFILE = g.get("--profile", "")
SVC, OP = pos
OPNAME = "".join(p.capitalize() for p in OP.split("-")).replace("Db", "DB")
if PROFILE == "broken" or SCEN == "badcreds":
    fail("InvalidClientTokenId", OPNAME if SVC != "sts" else "GetCallerIdentity", "The security token included in the request is invalid.")
ACCT = {"": "111111111111", "prod": "111111111111", "nonprod": "222222222222"}.get(PROFILE)
if ACCT is None:
    sys.stderr.write("\nThe config profile (%s) could not be found\n" % PROFILE); sys.exit(255)


def out(d):
    print(json.dumps(d, indent=2)); sys.exit(0)


if (SVC, OP) == ("sts", "get-caller-identity"):
    out({"UserId": "AIDAMOCKUSER", "Account": ACCT, "Arn": "arn:aws:iam::%s:user/dba" % ACCT})
if (SVC, OP) == ("ec2", "describe-regions"):
    out({"Regions": [{"Endpoint": "ec2.%s.amazonaws.com" % r, "RegionName": r, "OptInStatus": "opt-in-not-required"}
                     for r in ("us-east-1", "ap-south-1", "eu-west-1")]})
if SCEN == "accessdenied" and REGION == "eu-west-1" and OP == "describe-db-clusters":
    fail("AccessDenied", "DescribeDBClusters", "User is not authorized to perform: rds:DescribeDBClusters")

# ------------------------------------------------------------------ engine version catalogue (per engine)
def fam(major, minors, fmt="%s"):
    return [(fmt % m, major) for m in minors]


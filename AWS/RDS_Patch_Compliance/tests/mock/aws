    for k in range(n):
        inst("bulk-pg-%05d" % k, "postgres", vers[k % 6], tg=tags("prod", "team-%d" % (k % 7), "bulk-app-with-a-long-name-%d" % k))
elif SCEN != "empty" and REGION == "us-east-1" and PROFILE in ("", "prod"):
    P = tags("prod", "payments", "pay")
    cluster("pay-aurora-pg16", "aurora-postgresql", "16.9", ["pay-aurora-pg16-1", "pay-aurora-pg16-2"], P)
    c = cluster("orders-aurora-pg15", "aurora-postgresql", "15.8", ["orders-pg15-1", "orders-pg15-2", "orders-pg15-3"], tags("prod", "orders", "orders"))
    pma(c["DBClusterArn"], [("system-update", "Upgrade to Aurora PostgreSQL 15.8.1 patch", 17, 47, None)])
    pma(arn("db", "orders-pg15-2"), [("os-upgrade", "New Operating System update is available", None, None, "next-maintenance")])
    cluster("crm-aurora-pg15", "aurora-postgresql", "15.10", ["crm-pg15-1"], tags("prod", "crm", "crm"))
    cluster("legacy-aurora-pg12", "aurora-postgresql", "12.15", ["legacy-pg12-1", "legacy-pg12-2"], tags("prod", "finance", "legacy-gl"))
    cluster("old-aurora-pg11", "aurora-postgresql", "11.9", ["old-pg11-1"], tags("prod", "finance", "archive"))
    cluster("reports-aurora-pg14", "aurora-postgresql", "14.12", ["reports-pg14-1", "reports-pg14-2"], tags("prod", "bi", "reports"), autos=[False, False])
    cluster("shop-aurora-mysql", "aurora-mysql", AMY % "3.05.2", ["shop-mysql-1", "shop-mysql-2"], tags("prod", "shop", "storefront"), autos=[True, False])
    cluster("cms-aurora-mysql", "aurora-mysql", AMY % "3.09.0", ["cms-mysql-1"], tags("prod", "web", "cms"))
    cluster("ledger-maz", "postgres", "16.6", ["ledger-maz-1", "ledger-maz-2", "ledger-maz-3"], tags("prod", "finance", "ledger"), auto=True, maz=True)
    inst("billing-pg", "postgres", "16.8", tg=tags("prod", "billing", "billing"))

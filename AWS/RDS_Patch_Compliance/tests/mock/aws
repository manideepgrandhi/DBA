    "mysql": fam("8.4", ["8.4.3", "8.4.4", "8.4.5", "8.4.6"]) + fam("8.0", ["8.0.36", "8.0.37", "8.0.39", "8.0.40", "8.0.41", "8.0.42", "8.0.43"]),
    "mariadb": fam("10.11", ["10.11.9", "10.11.10", "10.11.11"]),
    "sqlserver-se": fam("15.00", ["15.00.4385.2.v1", "15.00.4395.2.v1", "15.00.4410.1.v1", "15.00.4415.2.v1", "15.00.4420.2.v1", "15.00.4430.1.v1"])
        + fam("16.00", ["16.00.4165.4.v1", "16.00.4175.1.v1", "16.00.4185.3.v1"]),
    "oracle-ee": fam("19", ["19.0.0.0.ru-2025-01.rur-2025-01.r1", "19.0.0.0.ru-2025-04.rur-2025-04.r1", "19.0.0.0.ru-2025-07.rur-2025-07.r1"]),
    "docdb": [("4.0.0", None), ("5.0.0", None)],
    "neptune": [(v, None) for v in ("1.3.2.1", "1.3.3.0", "1.3.4.0", "1.4.0.0", "1.4.1.0", "1.4.5.0")],
}
LC = {  # engine -> major -> (standard end days, extended end days)
    "aurora-postgresql": {"11": (-600, 500), "12": (-580, 800), "14": (800, 1900), "15": (1200, 2300), "16": (1500, 2600)},
    "aurora-mysql": {"5.7": (-400, 520), "8.0": (900, 2000)},
    "postgres": {"13": (120, 1200), "16": (1500, 2600), "17": (1800, 2900)},
    "mysql": {"8.0": (170, 1260), "8.4": (2000, 3100)},
    "mariadb": {"10.11": (1000, None)},
}

# Per-version ValidUpgradeTarget (what RDS really allows FROM that version). It intentionally differs from the
# full engine list above: 15.8 cannot go to 15.13 yet, 14.12 cannot go to 14.18 (a newer listed release that is not
# a valid target from 14.12), 3.05.2 cannot go to 3.06.1 / 3.08.0 / 3.08.1, and major targets are mixed in.
# (target, IsMajorVersionUpgrade, AutoUpgrade). Versions not listed here: every later version of the same major.
M = True
TGT = {
    ("aurora-postgresql", "15.8"): [("15.10", False, False), ("15.12", False, True), ("16.4", M, False), ("16.8", M, False)],
    ("aurora-postgresql", "15.4"): [(v, False, v == "15.12") for v in ("15.5", "15.6", "15.7", "15.8", "15.10", "15.12", "15.13")] + [("16.1", M, False)],
    ("aurora-postgresql", "14.12"): [("14.13", False, False), ("14.15", False, True), ("14.17", False, False), ("15.7", M, False), ("16.3", M, False)],
    ("aurora-postgresql", "12.15"): [(v, False, False) for v in ("12.16", "12.17", "12.18", "12.19", "12.20", "12.22")] + [("13.16", M, False)],
    ("aurora-mysql", AMY % "3.05.2"): [(AMY % v, False, v == "3.08.2") for v in ("3.06.0", "3.07.1", "3.08.2", "3.09.0", "3.10.0")],
    ("mysql", "8.0.36"): [(v, False, v == "8.0.40") for v in ("8.0.37", "8.0.39", "8.0.40", "8.0.41", "8.0.42", "8.0.43")] + [("8.4.3", M, False), ("8.4.6", M, False)],
    ("postgres", "13.18"): [("13.20", False, False), ("13.21", False, False), ("13.22", False, True), ("14.13", M, False), ("16.4", M, False)],
    ("postgres", "16.8"): [("16.9", False, False), ("16.10", False, True), ("17.4", M, False), ("17.6", M, False)],
    ("sqlserver-se", "15.00.4410.1.v1"): [("15.00.4415.2.v1", False, False), ("15.00.4420.2.v1", False, False), ("15.00.4430.1.v1", False, True), ("16.00.4185.3.v1", M, False)],
    ("neptune", "1.3.2.1"): [("1.3.3.0", False, False), ("1.3.4.0", False, True), ("1.4.1.0", M, False), ("1.4.5.0", M, False)],
}


def targets(eng, v, major):
    if (eng, v) in TGT:
        return TGT[(eng, v)]
    fam = [x for x, mj in CAT.get(eng, []) if (mj or x.rsplit(".", 2)[0]) == (major or v.rsplit(".", 2)[0])]
    return [(x, False, False) for x in fam if fam.index(x) > fam.index(v)]


if OP == "describe-db-engine-versions":
    eng, want = o.get("--engine", ""), o.get("--engine-version")
    if SCEN == "lookupfail" and eng == "aurora-mysql":
        fail("Throttling", "DescribeDBEngineVersions", "Rate exceeded")
    vers = []
    for v, major in CAT.get(eng, []):
        if want is not None and v != want:
            continue
        fam_major = major or ".".join(v.split(".")[:2])
        e = {"Engine": eng, "EngineVersion": v, "DBParameterGroupFamily": eng + fam_major, "DBEngineDescription": eng,
             "DBEngineVersionDescription": "%s %s" % (eng, v),
             "ValidUpgradeTarget": [{"Engine": eng, "EngineVersion": t, "IsMajorVersionUpgrade": mj, "AutoUpgrade": au,
                                     "Description": "%s %s" % (eng, t)} for t, mj, au in targets(eng, v, major)]}
        if SVC == "rds":
            e.update({"MajorEngineVersion": major, "Status": "available"})
        vers.append(e)
    out({"DBEngineVersions": vers})

if OP == "describe-db-major-engine-versions":
    eng = o.get("--engine", "")
    if SCEN == "lcfail":
        fail("AccessDenied", "DescribeDBMajorEngineVersions", "User is not authorized to perform: rds:DescribeDBMajorEngineVersions")
    res = []
    for major, (std, ext) in LC.get(eng, {}).items():
        l = [{"LifecycleSupportName": "open-source-rds-standard-support", "LifecycleSupportStartDate": day(-1500), "LifecycleSupportEndDate": day(std)}]
        if ext is not None:
            l.append({"LifecycleSupportName": "open-source-rds-extended-support", "LifecycleSupportStartDate": day(std), "LifecycleSupportEndDate": day(ext)})
        res.append({"Engine": eng, "MajorEngineVersion": major, "SupportedEngineLifecycles": l})
    out({"DBMajorEngineVersions": res})

# ------------------------------------------------------------------ fleet
def arn(kind, ident):
    return "arn:aws:rds:%s:%s:%s:%s" % (REGION, ACCT, kind, ident)


def tags(env, owner, app):
    return [{"Key": "Environment", "Value": env}, {"Key": "Owner", "Value": owner}, {"Key": "Application", "Value": app}]


CL, INS, PMA = [], [], []


def inst(ident, engine, ver, auto=True, cluster=None, cls="db.r6g.large", tg=None, window="sun:20:00-sun:20:30"):
    d = {"DBInstanceIdentifier": ident, "DBInstanceClass": cls, "Engine": engine, "DBInstanceStatus": "available",
         "EngineVersion": ver, "AutoMinorVersionUpgrade": auto, "PreferredMaintenanceWindow": window,
         "DBInstanceArn": arn("db", ident), "MultiAZ": False, "TagList": tg or [],
         "EngineLifecycleSupport": "open-source-rds-extended-support"}
    if cluster:
        d["DBClusterIdentifier"] = cluster
    INS.append(d)
    return d


def cluster(ident, engine, ver, members, tg, window="sat:21:00-sat:21:30", auto=None, maz=False, autos=None):
    c = {"DBClusterIdentifier": ident, "Engine": engine, "EngineVersion": ver, "Status": "available",
         "DBClusterArn": arn("cluster", ident), "PreferredMaintenanceWindow": window, "TagList": tg,
         "MultiAZ": len(members) > 1, "EngineMode": "provisioned",
         "DBClusterMembers": [{"DBInstanceIdentifier": m, "IsClusterWriter": n == 0, "DBClusterParameterGroupStatus": "in-sync", "PromotionTier": 1}
                              for n, m in enumerate(members)]}
    if maz:
        c["DBClusterInstanceClass"] = "db.m6gd.large"
    if auto is not None:
        c["AutoMinorVersionUpgrade"] = auto
    if engine.startswith("aurora"):
        c["EngineLifecycleSupport"] = "open-source-rds-extended-support"
    CL.append(c)
    for n, m in enumerate(members):
        inst(m, engine, ver, auto=(autos[n] if autos else True), cluster=ident, tg=tg, window=window)
    return c


def at(n):
    return (NOW + timedelta(days=n)).strftime("%Y-%m-%dT20:00:00+00:00")


def pma(a, actions):
    """actions: (action, description, auto-apply days or None, forced days or None, opt-in status or None)"""
    det = []
    for act, desc, auto, forced, opt in actions:
        d = {"Action": act, "Description": desc}
        if auto is not None:
            d["AutoAppliedAfterDate"] = at(auto)
        if forced is not None:
            d["ForcedApplyDate"] = at(forced)
        if opt:
            d["OptInStatus"] = opt
        cur = [x for x in (auto, forced) if x is not None]
        if cur or opt:
            d["CurrentApplyDate"] = at(min(cur) if cur else 7)
        det.append(d)
    PMA.append({"ResourceIdentifier": a, "PendingMaintenanceActionDetails": det})


if SCEN == "large" and REGION == "us-east-1" and PROFILE in ("", "prod"):
    n = int(os.environ.get("MOCK_LARGE_N", "3000"))

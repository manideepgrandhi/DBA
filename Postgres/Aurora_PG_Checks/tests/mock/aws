def series(target, metric, n):
    base, peak = W["metrics"].get((target, metric), (BASE.get(metric, 0), None))
    seed = int(hashlib.md5((target + metric).encode()).hexdigest()[:6], 16)
    vals = []
    for k in range(n):
        amp = 0.002 if metric == "BufferCacheHitRatio" else 0.08
        v = min(base * (1 + amp * math.sin((k + seed) / 5.0)), 100.0 if metric.endswith(("Ratio", "Utilization")) else float("inf"))
        if peak is not None and k >= n - max(2, n // 12):
            v = peak
        vals.append(round(v, 6))
    return vals



                    "SnapshotType": typ, "PercentProgress": 100, "StorageEncrypted": True, "KmsKeyId": c["KmsKeyId"],
                    "DBClusterSnapshotArn": arn("cluster-snapshot", sid), "IAMDatabaseAuthenticationEnabled": True,
                    "TagList": [], "StorageType": "aurora", "DbClusterResourceId": c["DbClusterResourceId"]}
        first = 6 if SCEN != "issues" else 30   # issues: newest automated snapshot is 30h old
        for d in range(c["BackupRetentionPeriod"]):
            t = ago(hours=first + 24 * d)
            snaps.append(snap("rds:%s-%s" % (cid, t.strftime("%Y-%m-%d-%H-%M")), "automated", t))
        snaps.append(snap("%s-pre-upgrade" % cid, "manual", ago(days=45)))
        snaps.append(snap("%s-before-release-42" % cid, "manual", ago(days=9)))
    out({"DBClusterSnapshots": snaps})

if OP == "describe-events":
    st = o["--source-type"]
    out({"Events": [e for e in W["events"] if e["SourceType"] == st]})

if OP == "describe-db-parameters":
    pg = o["--db-parameter-group-name"]
    params = W["params"].get(pg) or [{"ParameterName": "max_connections", "ParameterValue": "LEAST({DBInstanceClassMemory/9531392},5000)",
                                     "Description": "Sets the maximum number of concurrent connections.", "Source": "engine-default",
                                     "ApplyType": "static", "DataType": "integer", "AllowedValues": "6-262143",
                                     "IsModifiable": True, "ApplyMethod": "pending-reboot"}]
    q = g.get("--query", "")
    if q == "Parameters[?ParameterName=='max_connections']":
        out([p for p in params if p["ParameterName"] == "max_connections"])
    out({"Parameters": params})

if OP == "get-metric-data":
    if SCEN == "apifail":
        fail("Throttling", "GetMetricData", "Rate exceeded")
    path = o["--metric-data-queries"]
    if not path.startswith("file://"):
        sys.stderr.write("mock: expected file:// queries\n"); sys.exit(252)
    qs = json.load(open(path[7:]))
    if os.environ.get("MOCK_CAPTURE"):
        os.makedirs(os.environ["MOCK_CAPTURE"], exist_ok=True)
        shutil.copy(path[7:], os.path.join(os.environ["MOCK_CAPTURE"], os.path.basename(path[7:])))
    if len(qs) > 500:
        fail("ValidationError", "GetMetricData", "The collection MetricDataQueries must not have a size greater than 500.", 254)
    start = datetime.fromisoformat(o["--start-time"].replace("Z", "+00:00"))
    end = datetime.fromisoformat(o["--end-time"].replace("Z", "+00:00"))
    res = []
    for q in qs:
        assert q["Id"][0].islower(), q["Id"]
        ms = q["MetricStat"]; per = ms["Period"]
        tgt = ms["Metric"]["Dimensions"][0]["Value"]; name = ms["Metric"]["MetricName"]
        t0 = datetime.fromtimestamp((int(start.timestamp()) // per + 1) * per, timezone.utc)
        ts = []
        while t0 < end:
            ts.append(t0); t0 += timedelta(seconds=per)
        vals = series(tgt, name, len(ts))
        if SCEN == "fleet" and name in ("ReplicationSlotDiskUsage", "OldestReplicationSlotLag") and tgt.startswith("payments"):
            ts, vals = [], []   # no data for this metric
        r = {"Id": q["Id"], "Label": q.get("Label", name), "Timestamps": [iso(t, False) for t in ts], "Values": vals, "StatusCode": "Complete"}
        if SCEN == "metrics" and len(ts) > 4:   # simulate CLI auto-pagination splitting a result into two entries
            h = len(ts) // 2
            res.append(dict(r, Timestamps=r["Timestamps"][:h], Values=vals[:h]))
            res.append(dict(r, Timestamps=r["Timestamps"][h:], Values=vals[h:]))
        else:
            res.append(r)
    out({"MetricDataResults": res, "Messages": []})

sys.stderr.write("mock: unhandled %s %s\n" % (SVC, OP)); sys.exit(252)

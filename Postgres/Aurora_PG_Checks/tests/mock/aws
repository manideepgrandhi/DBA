def topo(cid, version, cls, n, region_azs, **ckw):
    """writer + (n-1) readers spread over AZs"""
    ins, mem = [], []
    for k in range(n):
        iid = "%s-%d" % (cid, k + 1)
        ins.append(instance(iid, cid, cls if isinstance(cls, str) else cls[k], region_azs[k % len(region_azs)], version,
                            PromotionTier=0 if k < 2 else 1))
        mem.append((iid, k == 0, 0 if k < 2 else 1))
    return cluster(cid, version, mem, **ckw), ins


